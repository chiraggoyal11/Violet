PORT=5000
MONGO=mongodb://127.0.0.1:27017/violet
jwtSecret=change_me_to_a_long_random_string
CORS_ORIGIN=http://localhost:5173

# Object storage for product images.
# Local default: MinIO (S3-compatible). For real AWS S3, remove S3_ENDPOINT
# and set ACCESS_KEY / SECRET_ACCESS_KEY to your IAM credentials.
BUCKET_NAME=violet-products
BUCKET_REGION=us-east-1
ACCESS_KEY=minioadmin
SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
