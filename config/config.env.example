PORT=5000
MONGO=mongodb://127.0.0.1:27017/violet
jwtSecret=change_me_to_a_long_random_string
CORS_ORIGIN=http://localhost:5173

# --- AWS S3 (production / real AWS) ---
# Create an S3 bucket in this region, then fill in IAM access keys.
# Do NOT set S3_ENDPOINT when using real AWS.
BUCKET_NAME=your-violet-bucket-name
BUCKET_REGION=us-east-1
ACCESS_KEY=AKIA...
SECRET_ACCESS_KEY=your_secret_access_key

# Optional aliases also supported by the app:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Local MinIO only (optional) ---
# Uncomment these instead of ACCESS_KEY/SECRET above for local MinIO:
# BUCKET_NAME=violet-products
# BUCKET_REGION=us-east-1
# ACCESS_KEY=minioadmin
# SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://127.0.0.1:9000
